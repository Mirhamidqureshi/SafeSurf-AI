# ============================================================
# SafeSurf AI — Environment Variables
# ============================================================
# 1. Copy this file:   copy .env.example .env   (Windows)
#                      cp .env.example .env     (Mac/Linux)
# 2. Fill in your API keys below
# 3. Never share or commit your .env file!
# ============================================================

# ── Google Safe Browsing API ─────────────────────────────────
# Get free key: https://console.cloud.google.com
# Enable "Safe Browsing API" in your project
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# ── VirusTotal API ───────────────────────────────────────────
# Get free key: https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ── AbuseIPDB API ────────────────────────────────────────────
# Get free key: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ── OpenPhish API (Optional) ─────────────────────────────────
# Get access: https://openphish.com
# Leave as-is if you don't have a key
OPENPHISH_API_KEY=your_openphish_api_key_optional

# ── Server Settings ──────────────────────────────────────────
SERVER_PORT=5000
DEBUG_MODE=True
MAX_URL_LENGTH=2048

# ── Scoring Weights ──────────────────────────────────────────
HTTPS_WEIGHT=30
DOMAIN_AGE_WEIGHT=20
REPUTATION_WEIGHT=25
THREAT_WEIGHT=50

# ── Rate Limits ──────────────────────────────────────────────
GOOGLE_RATE_LIMIT=100
VIRUSTOTAL_RATE_LIMIT=4
